# Copy this file to `.env` and fill in / adjust as needed.
# All values shown are the defaults used if a variable is not set.

# --- Camera ---
CAMERA_FPS=30

# --- Pose model ---
# CUDA Desktop defaults: yolov8m-pose.pt at 960px. CPU defaults: yolov8n-pose.pt at 640px.
# Set YOLO_POSE_MODEL to override automatic model selection.
YOLO_POSE_MODEL=
YOLO_POSE_MODEL_CPU=yolov8n-pose.pt
YOLO_POSE_MODEL_CUDA=yolov8m-pose.pt
YOLO_POSE_IMGSZ_CPU=640
YOLO_POSE_IMGSZ_CUDA=960
YOLO_POSE_MAX_DET=1000
YOLO_POSE_CONF=0.10
YOLO_POSE_IOU=0.65

# --- Fall detection ---
FALL_ANGLE_THRESHOLD=55
FALL_MIN_FRAMES=5
FALL_MIN_DROP_RATIO=0.35
KEYPOINT_CONF_THRESHOLD=0.5
INACTIVITY_FRAMES=15
INACTIVITY_MOTION_THRESHOLD=0.01
HORIZONTAL_RATIO_THRESHOLD=1.3

# --- Fight detection ---
FIGHT_MOTION_THRESHOLD=0.035
FIGHT_SPIKE_THRESHOLD=0.06
FIGHT_NEAR_DISTANCE_RATIO=0.12
FIGHT_MIN_FRAMES=3
MOTION_HISTORY=5

# --- Density ---
DENSITY_AREA_SCALE=100000
DENSITY_MEDIUM=8
DENSITY_HIGH=15

# --- Decision agent ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AGENT_TEMPERATURE=0.2
AGENT_CALL_EVERY_N_FRAMES=10
RISK_HIGH_STREAK_FRAMES=30
ACTION_COOLDOWN_SECONDS=10

# --- Output ---
DISPLAY_WINDOW=1
SAVE_SCREENSHOT_ON_HIGH_RISK=1
SAVE_CLIP_ON_HIGH_RISK=1
CLIP_SECONDS=3

# --- Tracking ---
TRACK_MAX_DISTANCE_RATIO=0.1
TRACK_MAX_LOST=30

RECENT_EVENT_HISTORY=10
