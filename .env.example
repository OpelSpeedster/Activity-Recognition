# Copy this file to `.env` and fill in / adjust as needed.
# All values shown are the defaults used if a variable is not set.

# --- Camera ---
CAMERA_FPS=30

# --- Pose model ---
# CUDA Desktop defaults: yolov8m-pose.pt at 960px. CPU defaults: yolov8n-pose.pt at 640px.
# Set YOLO_POSE_MODEL to override automatic model selection.
YOLO_POSE_MODEL=
YOLO_POSE_MODEL_CPU=yolov8n-pose.pt
YOLO_POSE_MODEL_CUDA=yolov8m-pose.pt
YOLO_POSE_IMGSZ_CPU=640
YOLO_POSE_IMGSZ_CUDA=960
YOLO_POSE_MAX_DET=1000
YOLO_POSE_CONF=0.10
YOLO_POSE_IOU=0.65

# --- Fall detection ---
FALL_ANGLE_THRESHOLD=55
FALL_MIN_FRAMES=5
FALL_MIN_DROP_RATIO=0.35
KEYPOINT_CONF_THRESHOLD=0.5
INACTIVITY_FRAMES=15
INACTIVITY_MOTION_THRESHOLD=0.01
HORIZONTAL_RATIO_THRESHOLD=1.3

# --- Fight detection ---
FIGHT_MOTION_THRESHOLD=0.035
FIGHT_SPIKE_THRESHOLD=0.06
FIGHT_NEAR_DISTANCE_RATIO=0.12
FIGHT_MIN_FRAMES=3
MOTION_HISTORY=5

# --- Density ---
DENSITY_AREA_SCALE=100000
DENSITY_MEDIUM=8
DENSITY_HIGH=15

# --- Decision agent ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AGENT_TEMPERATURE=0.2
AGENT_CALL_EVERY_N_FRAMES=10
RISK_HIGH_STREAK_FRAMES=30
ACTION_COOLDOWN_SECONDS=10

# --- Groq agentic second-opinion verifier ---
# Local rules stay the decision authority. A vision agent (Qwen) sees the
# actual snapshot + detector context, a decision agent (GPT-OSS) turns that
# into an independent JSON verdict plus the WhatsApp alert text, and that
# verdict is compared against the local decision.
#
# GROQ_API_KEY = one key covers both agents, from console.groq.com/keys
GROQ_API_KEY=
# Both defaults are live Groq model IDs. VISION_MODEL must accept image input;
# DECISION_MODEL needs reliable structured output (gpt-oss-120b has
# strict:true). Alternatives: openai/gpt-oss-20b (cheaper, weaker).
VISION_MODEL=qwen/qwen3.8-27b
DECISION_MODEL=openai/gpt-oss-120b
VERIFY_TEMPERATURE=0.0
VISION_MAX_TOKENS=700
DECISION_MAX_TOKENS=700
# Hard budget for one agent call; over budget -> human review.
VERIFY_TIMEOUT_SECONDS=10
# Warn when a completed verification beats/exceeds this latency target.
# 2000 because both agents run on Groq at ~450-500 tps.
VERIFY_LATENCY_TARGET_MS=2000
# Verify medium/high risk decisions only (low risk has nothing to disagree about).
VERIFY_ENABLED=1
# Agentic verification fires only on HIGH risk held for at least this many
# seconds. Brief spikes and all medium risk run the normal local path with no
# network call. 0.0 verifies every high-risk frame the moment it appears.
VERIFY_MIN_HIGH_RISK_SECONDS=2.0
# 1 = both agents run on a worker thread so the video loop never stalls.
VERIFY_ASYNC=1

# --- Escalation (NOT emergency services: notifies a designated reviewer) ---
# Digits only, with country code (e.g. 919876543210). Empty = channel disabled.
AUTHORITY_WHATSAPP_NUMBER=
AUTHORITY_PHONE_NUMBER=
# Second number: receives the "please evaluate" request on VLM mismatch/failure.
REVIEWER_WHATSAPP_NUMBER=
# Automatically escalate when BOTH local rules and the VLM agree risk is high.
ESCALATE_ON_AGREED_HIGH=1
ESCALATION_COOLDOWN_SECONDS=30
REVIEW_REQUEST_COOLDOWN_SECONDS=60
# 1 = print the wa.me/tel: links instead of opening them (safe testing).
ESCALATION_DRY_RUN=0
# Console approve/reject prompt when the VLM fails or disagrees.
HITL_PROMPT_ENABLED=1

# --- Telegram reviewer delivery ---
# Bot token and destination chat ID; leave blank to disable Telegram delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=10

# --- Evidence server (serves frames/ so the wa.me link shows the photo) ---
# wa.me is text-only; without this the message carries a file path instead.
EVIDENCE_SERVER_ENABLED=0
EVIDENCE_SERVER_PORT=8090
# Your machine's LAN IP, e.g. 192.168.1.5 -- the authority's phone must be
# on the same network to open the link.
EVIDENCE_PUBLIC_HOST=

# --- Output ---
DISPLAY_WINDOW=1
SAVE_SCREENSHOT_ON_HIGH_RISK=1
SAVE_CLIP_ON_HIGH_RISK=1
CLIP_SECONDS=3

# --- Tracking ---
TRACK_MAX_DISTANCE_RATIO=0.1
TRACK_MAX_LOST=30

RECENT_EVENT_HISTORY=10
